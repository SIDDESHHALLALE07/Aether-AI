# Environment Configuration Template for Aether Copilot AI

# Server Configuration
PORT=8000
ENVIRONMENT=development
LOG_LEVEL=info
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173"]

# Security & JWT
SECRET_KEY=replace-this-with-a-secure-random-64-character-hex-string
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration (Supabase PostgreSQL / Local Fallback)
# Local SQLite Fallback: sqlite:///./aether_dev.db
# Supabase PostgreSQL: postgresql://postgres:[PASSWORD]@[HOST]:5432/[DATABASE]
DATABASE_URL=sqlite:///./aether_dev.db

# Storage Driver ('local' or 'r2')
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Cloudflare R2 Credentials (Optional - required if STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aether-datasets
R2_ENDPOINT_URL=https://<account_id>.r2.cloudflarestorage.com

# Gemini AI API Configuration
# Get your API key from Google AI Studio (https://aistudio.google.com)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# Vector Store Settings
EMBEDDING_MODEL=all-MiniLM-L6-v2
VECTOR_SIMILARITY_THRESHOLD=0.7
