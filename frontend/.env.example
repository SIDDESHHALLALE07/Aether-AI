# ==============================================================================
# Aether AI - Frontend Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env or configure in Vercel Project Settings > Environment Variables.
# NOTE: In local development, leaving this empty defaults to the Vite proxy (/api/v1 -> http://127.0.0.1:8000).
# In production on Vercel, set this to your hosted backend FastAPI base URL.
# ==============================================================================

# Backend API Base URL
# Examples:
# - Production backend: https://api.aether.example.com
# - Hosted service: https://aether-backend.onrender.com
# - Leave blank for local development proxy:
VITE_API_URL=
