# ==============================================================================
# Aether AI - Backend Production Environment Configuration Template
# ==============================================================================
# Copy this file to .env and configure the values for your production environment.
# DO NOT commit real secrets or production credentials to source control.
# ==============================================================================

# Core Application Settings
PROJECT_NAME=Aether
API_V1_STR=/api/v1
PORT=8000
ENVIRONMENT=production
LOG_LEVEL=info

# Cross-Origin Resource Sharing (CORS)
# Comma-separated list or JSON array of allowed origins (e.g. your Vercel deployment URL)
CORS_ORIGINS=https://your-aether-frontend.vercel.app,http://localhost:5173

# Security & Authentication
# Generate a strong 64-character secret key (e.g., using: openssl rand -hex 32)
SECRET_KEY=
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Configuration
# Production PostgreSQL connection URL (e.g., Supabase / Neon / AWS RDS)
# Format: postgresql://<user>:<password>@<host>:<port>/<database>
DATABASE_URL=

# Storage Configuration
# Options: 'local' or 'r2'
STORAGE_DRIVER=local
LOCAL_STORAGE_PATH=./storage/uploads

# Cloudflare R2 Object Storage (Required if STORAGE_DRIVER=r2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET_NAME=aether-datasets

# Google Gemini AI Integration (Backend only - never exposed to frontend)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
